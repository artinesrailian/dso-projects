# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
# The Makefile saves plans as tf.plan, not *.tfplan — a saved plan embeds
# every variable value, prior state and planned attributes (CA data, ARNs,
# emails, allowlist CIDRs), so it needs the same protection as state itself.
*.plan
crash.log
crash.*.log

# Variable files may contain account IDs / CIDRs — never commit them
*.tfvars
*.tfvars.json
!*.tfvars.example

# Backend config carries the state bucket name
backend.hcl
!backend.hcl.example

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Editor / OS
.DS_Store
.idea/
.vscode/
