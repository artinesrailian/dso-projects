# Copy to backend.hcl and fill in from the `bootstrap/` outputs:
#   cp backend.hcl.example backend.hcl
#   terraform -chdir=bootstrap output backend_config
# backend.hcl is gitignored — it is never committed.
bucket     = "opsfleet-poc-tfstate-123456789012"
region     = "us-east-1"
kms_key_id = "arn:aws:kms:us-east-1:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
